 i18:=         N1-i1-i2-i3-i4-i5-i6-i7-i8-i9-i10-i11-i12-i13-i14-i15-i
16-i17:\n\n    flag:=10-N1;\n    flag:=min(flag,9);\n    mm:=max(i1,i2
