@article{ 16DiKiAl.LiH,
title = {Accurate dipole moment curve and non-adiabatic effects on the high resolution spectroscopic properties of the LiH molecule },
journal = JMS,
volume = {322},
number = {},
pages = {22 - 28},
year = {2016},
note = {},
issn = {0022-2852},
doi = {http://dx.doi.org/10.1016/j.jms.2016.03.001},
url = {http://www.sciencedirect.com/science/article/pii/S0022285216300297},
author = {Leonardo G. Diniz and Nikita Kirnosov and Alexander Alijah and José R. Mohallem and Ludwik Adamowicz},
keywords = {Dipole moment},
keywords = {Einstein coefficients},
keywords = {Non-adiabatic effects },
abstract = {Abstract A very accurate dipole moment curve (DMC) for the ground X 1 Σ + electronic state of the 7LiH molecule is reported. It is calculated with the use of all-particle explicitly correlated Gaussian functions with shifted centers. The \{DMC\} – the most accurate to our knowledge – and the corresponding highly accurate potential energy curve are used to calculate the transition energies, the transition dipole moments, and the Einstein coefficients for the rovibrational transitions with Δ J = - 1 and Δ v ⩽ 5 . The importance of the non-adiabatic effects in determining these properties is evaluated using the model of a vibrational R-dependent effective reduced mass in the rovibrational calculations introduced earlier (Diniz et al., 2015). The results of the present calculations are used to assess the quality of the two complete linelists of 7LiH available in the literature. }
}

