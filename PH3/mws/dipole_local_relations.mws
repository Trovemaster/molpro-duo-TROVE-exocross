n:=  60.0*evalf(Pi)/180:\nAmax:= 180.0*evalf(Pi)/180:\nNumPointA:=30:
\n\nDelta1:=(Rmax1-Rmin1)/(NumPoint1):\nDelta3:=(Rmax3-Rmin3)/(NumPoin
t3):\nDeltaA:=(Amax -Amin )/(NumPointA):\n\nReq1:=1.465820:\nReq3:=1.4
65820:\n\n" }}}{EXCHG {PARA 256 "> " 0 "" {MPLTEXT 1 0 931 "\nfor Nsta
te from 1 to 2 do\nfor n1 from 0 to NumPoint1 do\nfor n3 from 0 to Num
Point3 do\nfor nA from 0 to NumPointA do\n\n    R12:=  Rmin1+Delta1*n1
:\n    R32:=  Rmin3+Delta3*n3:\n    alpha:=Amin +DeltaA*nA:\n\n    x1:
= (R12-RE12):\n    x3:= (R32-RE32):\n    y := 1-cos(evalf(Pi)-alpha):
\n\n    Alpha:=alpha*180.0/evalf(Pi):\n\n    R1[n1]:=R12:\n    R3[n3]:
=R32:\n    A0[nA]:=Alpha:\n\n    if R12<=Req1 then\n      n_eq1:=n1:\n
    fi:\n    if R32<=Req3 then\n      n_eq3:=n3:\n    fi:\n\nMu:= P0+
\nadd( PA||i0*y^i0,i0=1..8 )+\n( P1 +add( P||i0||A1*y^i0,i0=1..4 ) )*(
x1+x3)+\n( P11+add( P||i0||A11*y^i0,i0=1..3 ) )*(x1^2+x3^2)+\n( P13+ad
d( P||i0||A13*y^i0,i0=1..3 ) )*(x1*x3)+\n( P111+add( P||i0||A111*y^i0,
i0=1..2 ) )*(x1^3+x3^3)+\n( P113+add( P||i0||A113*y^i0,i0=1..2 ) )*(x1
^2*x3+x3^2*x1)+\n( P1111+ P1A1111*y )*(x1^4+x3^4)+\n( P1113+ P1A1113*y
 )*(x1^3*x3+x3^3*x1)+\n( P1133+ P1A1133*y )*(x1^2*x3^2);\n\n    Dipol[
n1,n3,nA]:=Mu*evalf(sin(alpha)):\n\nod:\nod:\nod:\nod:\n\n" }}}}{SECT 
