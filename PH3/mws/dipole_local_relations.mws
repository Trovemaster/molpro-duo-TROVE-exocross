{EXCHG {PARA 256 "> " 0 "" {MPLTEXT 1 0 980 "Num:=0:\n\nfor nR1 from -
NumPointR to NumPointR do\nfor nR2 from -abs(nR1)  to abs(nR1) do\nfor
 nR3 from -abs(nR2)  to abs(nR2) do\nfor nA1 from -NumPointA to NumPoi
ntA do\nfor nA2 from -abs(nA1)  to abs(nA1) do\nfor nA3 from -abs(nA2)
  to abs(nA2) do\nNum:=Num+1:\n\n\n    R1:=  DeltaR*nR1:\n    R2:=  De
ltaR*nR2:\n    R3:=  DeltaR*nR3:\n    Alpha1:=DeltaA*nA1:\n    Alpha2:
=DeltaA*nA2:\n    Alpha3:=DeltaA*nA3:\n\n   V_T:=evalf(subs(r1=R1,r2=R
2,r3=R3,alpha1=Alpha1,alpha2=Alpha2,alpha3=Alpha3,V)):\n\n#   printf(
\n#   `%5.3f      %5.3f     %5.3f   %6.2f  %6.2f  %6.2f   %16.8f  1.0
\\n`, \n#    R1*10^8,R2*10^8,R3*10^8,Alpha1,Alpha2,Alpha3,V_T):\n\n#  \+
 alpha_0:=alpha_new:\n#   r_0:=r_new:\n\n   alpha_0:=alpha0:\n   r_0:=
re:\n\n\n   fprintf(File_pot,\n   `%5.3f      %5.3f     %5.3f   %6.2f \+
 %6.2f  %6.2f   %16.8f  1.0\\n`, \n    (r_0+R1)*10^8,(r_0+R2)*10^8,(r_
0+R3)*10^8,\n    (alpha_0+Alpha1)*180/pi,(alpha_0+Alpha2)*180/pi,(alph
a_0+Alpha3)*180/pi,V_T):\n\n \nod:\nod:\nod:\nod:\nod:\nod:\nprint(Num
):\n\n\nclose(File_pot);\n" }}{PARA 11 "" 1 "" {XPPMATH 20 "6#\"%,C" }
