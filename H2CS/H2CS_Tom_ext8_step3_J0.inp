
(  CALCULATION OF VIBRATION ENERGIES FOR h2co MOLECULE )
(  andrey's     molpro  pes-II                        )
(  2009,  Taylor type PES  12000 cut                   )

KinOrder  15  (Max order in the kinetic energy expansion)
PotOrder  8   (Max order in the potential energy expansion)

Natoms 4       (Number of atoms)
Nmodes 6       (Number of modes = 3*Natoms-6)

(ACTIVE SPACE CUTOFFS:)
PRIMITIVES
  Npolyads    14       (how many polyads we calculate)
  enercut    80000.   (energy cut in the primitive matrix for the diagonalization)
END

contraction
  npolyads      14
  enercut       80000.0
  coeff_thresh  1.0e-14
  degeneracy    1e-2
  sample_points  40
  sample_attempts 500
  symm_toler      1e-3
  model j=0
end


SYMGROUP   C2v(M)


DIAGONALIZER
  SYEV
  enermax 18000
end

dstep 0.005    (finite difference element for each mode )

COORDS     local 
TRANSFORM  R-THETA-TAU
MOLTYPE    zxy2
REFER-CONF RIGID  (Reference configuarion: RIGID or NON-RIGID)
MOLECULE   h2cs (Identifying the Molecule, e.g. PH3, BiH3 - optional)

verbose 5

ZMAT
    C   0  0  0  0  12.00000000
    S   1  0  0  0  31.97207100
    H   1  2  0  0   1.00782505
    H   1  2  3 -2   1.00782505
end

CHECK_POINT
HAMILTONIAN none  ascii
kinetic     read
potential   read
external    read
basis_set   read
CONTRACT    read
matelem     read split
extmatelem  none split  6 121
EIGENFUNC   save
END

sparse


     (type     chi_kin   chi_pot)
BASIS
  0,'JKtau', Jrot 0
  1,'numerov','BOND-LENGTH', 'morse',  range 0,17, resc 1.0, points 1000, borders -0.35,1.00 
  2,'numerov','BOND-LENGTH', 'morse',  range 0, 7, resc 2.0, points 1000, borders -0.5,0.9
  2,'numerov','BOND-LENGTH', 'morse',  range 0, 7, resc 2.0, points 1000, borders -0.5,0.9
  3,'numerov','ANGLE',       'linear', range 0,14, resc 1.0, points 1000, borders -1.2,1.2
  3,'numerov','ANGLE',       'linear', range 0,14, resc 1.0, points 1000, borders -1.2,1.2
  4,'numerov','DIHEDRAL',    'linear', range 0,14, resc 1.0, points 2000, borders -120.,  120.0 deg
END


equilibrium
  cs      0        1.608952
  ch1     0        1.086848
  ch2     0        1.086848
  h1cs    0        121.750 deg
  h2cs    0        121.750 deg
  tau     0        180.0000 deg
end


specparam
  a_cs    0        1.79000000
  a_ch1   0        1.90000000
  a_ch2   0        1.90000000
end



poten
nparam    418
pot_type  poten_zxy2_morse_cos
coeff     powers
