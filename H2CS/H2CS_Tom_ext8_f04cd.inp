
(  CALCULATION OF VIBRATION ENERGIES FOR h2co MOLECULE )
(  andrey's     molpro  pes-II                        )
(  2009,  Taylor type PES  12000 cut                   )

KinOrder  15  (Max order in the kinetic energy expansion)
PotOrder  8   (Max order in the potential energy expansion)

Natoms 4       (Number of atoms)
Nmodes 6       (Number of modes = 3*Natoms-6)

(ACTIVE SPACE CUTOFFS:)
PRIMITIVES
  Npolyads    14       (how many polyads we calculate)
  enercut    80000.   (energy cut in the primitive matrix for the diagonalization)
END

contraction
  npolyads      14
  enercut       80000.0
  coeff_thresh  1.0e-14
  degeneracy    1e-2
  sample_points  40
  sample_attempts 500
  symm_toler      1e-3
  model j=0
end


SYMGROUP   C2v(M)


DIAGONALIZER
  SYEV
  enermax 18000
end

dstep 0.005    (finite difference element for each mode )

COORDS     local 
TRANSFORM  R-THETA-TAU
MOLTYPE    zxy2
REFER-CONF RIGID  (Reference configuarion: RIGID or NON-RIGID)
MOLECULE   h2cs (Identifying the Molecule, e.g. PH3, BiH3 - optional)

verbose 5

ZMAT
    C   0  0  0  0  12.00000000
    S   1  0  0  0  31.97207100
    H   1  2  0  0   1.00782505
    H   1  2  3 -2   1.00782505
end

CHECK_POINT
HAMILTONIAN none ascii
potential   read
kinetic     read
external    read
basis_set   read
CONTRACT    read
matelem     none  split
extmatelem  read  split  6 123
EIGENFUNC   read
fit_poten   read  split  6 123
END





sparse 

