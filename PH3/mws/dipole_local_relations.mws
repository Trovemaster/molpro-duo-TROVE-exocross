{MPLTEXT 1 0 607 "Expan84321:=proc (V,s) local tt,t0,t1,t2,t3,t4:\n  t
t:=V:\n \n  t0:=mtaylor(tt,[s||1,s||2,s||3,s||4,s||5],1):\n  t0:=conve
rt(series(t0,s||6,9),polynom):\n\n  t1:=mtaylor(tt-t0,[s||1,s||2,s||3,
s||4,s||5],2):\n  t1:=convert(series(t1,s||6,5),polynom):\n\n  t2:=mta
ylor(tt-t0-t1,[s||1,s||2,s||3,s||4,s||5],3):\n  t2:=convert(series(t2,
s||6,4),polynom):\n\n  t3:=mtaylor(tt-t0-t1-t2,[s||1,s||2,s||3,s||4,s|
|5],4):\n  t3:=convert(series(t3,s||6,3),polynom):\n\n  t4:=mtaylor(tt
-t0-t1-t2-t3,[s||1,s||2,s||3,s||4,s||5],5):\n  t4:=convert(series(t4,s
||6,2),polynom):\n\n  tt:=simplify(evalf(t0+t1+t2+t3+t4)):\n  RETURN(t
t):\nend proc:\n" }}}{EXCHG {PARA 0 "> " 0 "" {MPLTEXT 1 0 0 "" }}}}
