17||i18)) then \n    Num:=Num+1:\n    fprintf(out,`f %a %a %a %a %a %a
 %a %a %a %a %a %a %a %a %a %a %a %a   %a  0.000\\n`,i1,i2,i3,i4,i5,i6
,i7,i8,i9,i10,i11,i12,i13,i14,i15,i16,i17,i18,flag);\n\n\nfi:\n\n\nod:
