683 "Num:=0:\nfor i from 1 to 3 do\nfor N1 from 0 to N do\nfor i1 from
 0 to N1 do\nfor i2 from 0 to N1-i1 do\nfor i3 from 0 to N1-i1-i2 do\n
for i4 from 0 to N1-i1-i2-i3 do\nif i4 <= i3 and i3 <= i2 then \nfor i
5 from 0 to N1-i1-i2-i3-i4 do\nfor i6 from 0 to N1-i1-i2-i3-i4-i5 do\n
for i7 from 0 to N1-i1-i2-i3-i4-i5-i6 do\nfor i8 from 0 to N1-i1-i2-i3
-i4-i5-i6-i7 do\n    i9:=         N1-i1-i2-i3-i4-i5-i6-i7-i8:\n    Num
:=Num+1:\n    flag:=10-N1;\n    flag:=min(flag,9);\n    mm:=max(i1,i2,
i3,i4,i5,i6,i7,i8,i9);\n    flag := flag - (N1-mm);\n    flag := max(1
,flag);\n    printf(`F %a  %a %a %a %a %a %a %a %a %a  %a  0.00 \\n`,i
,i1,i2,i3,i4,i5,i6,i7,i8,i9,flag);\nod:\nod:\nod:\nod:\nfi:\nod:\nod:
\nod:\nod:\nod:\nod:" }}{PARA 6 "" 1 "" {TEXT -1 32 "F 1  0 0 0 0 0 0 \+
