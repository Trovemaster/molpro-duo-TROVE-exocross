mem 1400 gb
PTorder   0   (Max Perturbation order )
KinOrder  2  (Max order in the kinetic energy expansion)
PotOrder  8  (Max order in the potential energy expansion)

Natoms 3      (Number of atoms)
Nmodes 3      (Number of modes = 3*Natoms-6)

(ACTIVE SPACE CUTOFFS:)
PRIMITIVES
  Npolyads       48           (how many polyads we calculate)
  enercut        50000.      (energy cut in the primitive matrix for the diagonalization)
END


CONTRACTION
  Npolyads        48     (how many polyads in the contracted represent.)
  enercut       60000.    (energy cut in the primitive matrix for the diagonalization)
  degeneracy    1e-2       (threashold to define degeneracy)
  sample_points   40
  sample_attempts 500
  symm_toler      1e-3
  coeff_thresh    1e-12   (  rotsym        euler )
END

verbose 4


dstep 0.005   (finite difference element for each mode )

COORDS       local (type of the internal coordinates: linear or local)
TRANSFORM    r-rho-z-abs  ( xi(chi): harmonic, linear, r-s-delta, r-s-rho, r-alpha-tau, r-rho see molecule.f90)
MOLTYPE      XY2    (Identifying type of the Molecule (e.g. XY3))
MOLECULE     CS2    (Identifying the Molecule, e.g. PH3, BiH3 - optional)
REFER-CONF   non-RIGID  (Reference configuarion: RIGID or NON-RIGID)


SYMGROUP C2vn 16


ZMAT
    C   0  0  0  0   11.996709
    S   1  0  0  0   31.963293895865
    S   1  2  0  0   31.963293895865
end



DIAGONALIZER
 SYEV
 enermax 24000.0
end


CHECK_POINT
ascii
potential   read with_modes
kinetic     save 
external    read with_modes
basis_set   save
CONTRACT    save
matelem     save  split
extmatelem  save  split
EIGENFUNC   save
END


sparse


BASIC-FUNCTION POTEN
Mode 1 9
1, 0 - 8, morse(x-xe)
Mode 2 9
1, 0 - 8, morse(x-xe)
Mode 3 9
1, 0 - 8, cos(a0)-cos(a)
end


BASIC-FUNCTION external
Mode 1 9
1, 0 - 8, morse(x-xe)
Mode 2 9
1, 0 - 8, morse(x-xe)
Mode 3 9
1, 0 - 8, cos(a0)-cos(a)
end



     (type     chi_kin   chi_pot)
BASIS
  0,'JKtau', Jrot 0, krot    16
  1,'numerov','rational', 'pot-auto',  range 0,36,r 8, resc 1.5, points  1000, borders 0.90,3.55
  1,'numerov','rational', 'pot-auto',  range 0,36,r 8, resc 1.5, points  1000, borders 0.90,3.55
  2,'laguerre-k','linear','pot-auto',  range 0,48, resc 1.0, points 15000, borders  0.,130.0 deg
END

sparse



EQUILIBRIUM
re13       1         1.552752713465
re13       1         1.552752713465
phie       0         180.0  DEG
end


SPECPARAM
aa         0         2.242114268057
aa         0         2.242114268057
END


KINETIC
  kinetic_type  KINETIC_XY2_EKE_BISECT
END

