261 "" 0 "" {TEXT -1 26 "RENNER state - MORBID form" }}{EXCHG {PARA 
256 "> " 0 "" {MPLTEXT 1 0 1786 "for Nstate from 1 to 2 do\nfor n1 fro
m 0 to NumPoint1 do\nfor n3 from 0 to NumPoint3 do\nfor nA from 0 to N
umPointA do\n\n    R12:=  Rmin1+Delta1*n1:\n    R32:=  Rmin3+Delta3*n3
:\n    alpha:=Amin +DeltaA*nA:\n\n    x1:= 1-exp(-AA1*(R12-RE12)):\n  \+
  x3:= 1-exp(-AA3*(R32-RE32)):\n    y := 1-cos(evalf(Pi)-alpha):\n\n  \+
  Alpha:=alpha*180.0/evalf(Pi):\n\n    R1[n1]:=R12:\n    R3[n3]:=R32:
\n    A0[nA]:=Alpha:\n\n    if R12<=Req1 then\n      n_eq1:=n1:\n    f
i:\n    if R32<=Req3 then\n      n_eq3:=n3:\n    fi:\n\n\n    if Nstat
e=1 then\nPoten:=\nadd( FA||i0*y^i0,i0=1..8 )+\n( F1 +add( F||i0||A1*y
^i0,i0=1..4 ) )*x1+\n( F3 +add( F||i0||A3*y^i0,i0=1..4 ) )*x3+\n( F11+
add( F||i0||A11*y^i0,i0=1..3 ) )*x1^2+\n( F33+add( F||i0||A33*y^i0,i0=
1..3 ) )*x3^2+\n( F13+add( F||i0||A13*y^i0,i0=1..3 ) )*(x1*x3)+\n( F11
1+add( F||i0||A111*y^i0,i0=1..2 ) )*x1^3+\n( F333+add( F||i0||A333*y^i
0,i0=1..2 ) )*x3^3+\n( F113+add( F||i0||A113*y^i0,i0=1..2 ) )*x1^2*x3+
\n( F133+add( F||i0||A133*y^i0,i0=1..2 ) )*x3^2*x1+\n( F1111+ F1A1111*
y )*x1^4+\n( F3333+ F1A3333*y )*x3^4+\n( F1113+ F1A1113*y )*x1^3*x3+\n
( F1333+ F1A1333*y )*x3^3*x1+\n( F1133+ F1A1133*y )*(x1^2*x3^2);\n\n  \+
  else\nPoten:=\nadd( GA||i0*y^i0,i0=1..8 )+\n( F1 +add( G||i0||A1*y^i
0,i0=1..4 ) )*x1+\n( F3 +add( G||i0||A3*y^i0,i0=1..4 ) )*x3+\n( F11+ad
d( G||i0||A11*y^i0,i0=1..3 ) )*x1^2+\n( F33+add( G||i0||A33*y^i0,i0=1.
.3 ) )*x3^2+\n( F13+add( G||i0||A13*y^i0,i0=1..3 ) )*(x1*x3)+\n( F111+
add( G||i0||A111*y^i0,i0=1..2 ) )*x1^3+\n( F333+add( G||i0||A333*y^i0,
i0=1..2 ) )*x3^3+\n( F113+add( G||i0||A113*y^i0,i0=1..2 ) )*x1^2*x3+\n
( F133+add( G||i0||A133*y^i0,i0=1..2 ) )*x3^2*x1+\n( F1111+ G1A1111*y \+
)*x1^4+\n( F3333+ G1A3333*y )*x3^4+\n( F1113+ G1A1113*y )*x1^3*x3+\n( \+
F1333+ G1A1333*y )*x3^3*x1+\n( F1133+ G1A1133*y )*(x1^2*x3^2);\n\n    \+
fi:\n\n\n    PotMor||Nstate[n1,n3,nA]:=Poten:\n\n\nod:\nod:\nod:\nod:
\n\n\n" }}}{EXCHG {PARA 256 "> " 0 "" {MPLTEXT 1 0 0 "" }}}}{SECT 0 
