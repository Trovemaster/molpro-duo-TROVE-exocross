9-i10 do\nfor i12 from 0 to N1-i1-i2-i3-i4-i5-i6-i7-i8-i9-i10-i11 do\n
for i13 from 0 to N1-i1-i2-i3-i4-i5-i6-i7-i8-i9-i10-i11-i12 do\nfor i1
4 from 0 to N1-i1-i2-i3-i4-i5-i6-i7-i8-i9-i10-i11-i12-i13 do\nfor i15 \+
from 0 to N1-i1-i2-i3-i4-i5-i6-i7-i8-i9-i10-i11-i12-i13-i14 do\nfor i1
6 from 0 to N1-i1-i2-i3-i4-i5-i6-i7-i8-i9-i10-i11-i12-i13-i14-i15 do\n
for i17 from 0 to N1-i1-i2-i3-i4-i5-i6-i7-i8-i9-i10-i11-i12-i13-i14-i1
5-i16 do\n\n    i18:=         N1-i1-i2-i3-i4-i5-i6-i7-i8-i9-i10-i11-i1
2-i13-i14-i15-i16-i17:\n\nif (assigned(f||i1||i2||i3||i4||i5||i6||i7||
i8||i9||i10||i11||i12||i13||i14||i15||i16||i17||i18)) then \n    Num:=
Num+1:\n    fprintf(out,`      f%a%a%a%a%a%a%a%a%a%a%a%a%a%a%a%a%a%a =
 param(N%a+%a)\\n`,i1,i2,i3,i4,i5,i6,i7,i8,i9,i10,i11,i12,i13,i14,i15,
