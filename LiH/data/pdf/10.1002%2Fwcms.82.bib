author = {Werner, Hans-Joachim and Knowles, Peter J. and Knizia, Gerald and Manby, Frederick R. and Schütz, Martin},
title = {Molpro: a general-purpose quantum chemistry program package},
journal-iso = {Wiley Interdisciplinary Reviews: Computational Molecular Science},
journal = {WIREs},
volume = {2},
number = {2},
publisher = {John Wiley & Sons, Inc.},
issn = {1759-0884},
url = {http://dx.doi.org/10.1002/wcms.82},
doi = {10.1002/wcms.82},
pages = {242--253},
year = {2012},
abstract = {Molpro (available at http://www.molpro.net) is a general-purpose quantum chemical program. The original focus was on high-accuracy wave function calculations for small molecules, but using local approximations combined with explicit correlation treatments, highly accurate coupled-cluster calculations are now possible for molecules with up to approximately 100 atoms. Recently, multireference correlation treatments were also made applicable to larger molecules. Furthermore, an efficient implementation of density functional theory is available. © 2011 John Wiley & Sons, Ltd.},
}
